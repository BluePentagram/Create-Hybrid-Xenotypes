{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Build & Run",
            "type": "node",
            "request": "launch",
            "cwd": "${workspaceFolder}/../../",
            "console": "internalConsole",
            "internalConsoleOptions":"neverOpen",
            "windows": {
                "runtimeExecutable": "${workspaceFolder}/../../RimWorldWin64.exe",
                "preLaunchTask": "build",
            },
            "linux": {
                "runtimeExecutable": "steam",
                "runtimeArgs": ["-applaunch", "294100"],
                "preLaunchTask": "build",
            }
        },  
    ],
    "compounds": [
        {
            "name": "Build & Debug",
            "configurations": [
                "Build & Run"
            ],
            "stopAll": true
        },
    ],
}